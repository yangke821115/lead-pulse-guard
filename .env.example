# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the filled version.
# ---------------------------------------------------------------------------

# --- Meta app ---
# App Secret. Prefer a mounted file over this variable in production;
# this is here so `docker compose up` works for a first local run.
META_APP_SECRET=replace-me

# Must match the Verify Token you enter in the Meta app dashboard.
META_VERIFY_TOKEN=replace-me

# Where the App Secret file is mounted inside the container.
# The service refuses to start if it is missing and no env var is set.
META_APP_SECRET_FILE=/run/secrets/meta_app_secret

# --- Pages ---
# Recommended: a JSON file mapping Page ID -> {name, kb}.
# Copy pages.example.json, fill in your real Page IDs, and mount it below.
PAGES_CONFIG_FILE=/etc/leadpulse/pages.json

# Fallback if PAGES_CONFIG_FILE does not exist: comma-separated Page IDs.
# Each Page then gets a generic name ("page-0", "page-1", ...) and kb "default".
PAGES=

# --- Spool ---
EVENT_SPOOL_FILE=/spool/events.jsonl
EVENT_SPOOL_MAX_BYTES=33554432

# --- Worker ---
# Leave false until you have reviewed drafts for a few days.
AIW_POST_ENABLED=false
AIW_MODEL=your-model-name
AIW_MAX_TOKENS=2000

# Cheap pool first, paid fallback second. Set both or neither.
AIW_FREELLM_URL=
AIW_FREE_MODEL=
AIW_FREE_ATTEMPTS=2
AIW_FREE_TIMEOUT=30

# --- Chat channel ---
CHAT_APP_ID=
CHAT_APP_SECRET_FILE=/run/secrets/chat_app_secret
CHAT_OPERATOR_ALLOWLIST=/etc/leadpulse/operator-allowlist

# ---------- worker ----------
# 代码目录（worker 包所在目录）
LPW_BASE=/opt/leadpulse/worker
# 凭据目录：飞书应用、主页令牌、审核白名单、群路由
LPW_SECRETS=/etc/leadpulse
LPW_GRAPH_SECRETS=/etc/leadpulse/graph
# 运行状态：spool 偏移、待审核队列、线索库
LPW_STATE=/var/lib/leadpulse

AIW_SPOOL=/var/lib/leadpulse/spool/events.jsonl

# 真实发布开关。默认 false = 只生成建议，不会发到 Facebook。
AIW_POST_ENABLED=false

# 模型
AIW_MODEL=deepseek-flash
AIW_MAX_TOKENS=2000

# 业务分类（写进提示词的 domain 字段）。按你的业务改。
AIW_DOMAIN_ENUM=general,other
AIW_DOMAIN_GUIDE=

# 询盘分析提示词开头的一句话公司说明
AIW_LEAD_CONTEXT=

# 飞书多维表格（留空则不写表格，只推卡片）
AIW_BITABLE_HOST=
AIW_BITABLE_APP=
AIW_BITABLE_TABLE=
AIW_BITABLE_VIEW=

# 线索卡片默认落点；留空则用 chat-routing.json 的第一个群
AIW_LEAD_CHAT=

# 表单选项映射文件
AIW_FORM_FIELDS=/opt/leadpulse/worker/lead-form-fields.json
