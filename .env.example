# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the filled version.
# ---------------------------------------------------------------------------

# --- Meta app ---
# App Secret. Prefer a mounted file over this variable in production;
# this is here so `docker compose up` works for a first local run.
META_APP_SECRET=replace-me

# Must match the Verify Token you enter in the Meta app dashboard.
META_VERIFY_TOKEN=replace-me

# Where the App Secret file is mounted inside the container.
# The service refuses to start if it is missing and no env var is set.
META_APP_SECRET_FILE=/run/secrets/meta_app_secret

# --- Pages ---
# comma-separated list of Page IDs you want to serve.
# Add matching entries to PAGE_REGISTRY in gateway/app.py, or override
# the whole registry through a config file (see docs/deployment.md).
PAGES=111111111111111,222222222222222

# --- Spool ---
EVENT_SPOOL_FILE=/spool/events.jsonl
EVENT_SPOOL_MAX_BYTES=33554432

# --- Worker ---
# Leave false until you have reviewed drafts for a few days.
AIW_POST_ENABLED=false
AIW_MODEL=your-model-name
AIW_MAX_TOKENS=2000

# Cheap pool first, paid fallback second. Set both or neither.
AIW_FREELLM_URL=
AIW_FREE_MODEL=
AIW_FREE_ATTEMPTS=2
AIW_FREE_TIMEOUT=30

# --- Chat channel ---
CHAT_APP_ID=
CHAT_APP_SECRET_FILE=/run/secrets/chat_app_secret
CHAT_OPERATOR_ALLOWLIST=/etc/leadpulse/operator-allowlist
